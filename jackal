#!/usr/bin/env python3
"""jackal — launch Claude Code against a custom Anthropic gateway.

Gateways live under ~/.jackal/<name>.env (0600). Manage them with:
  jackal --setup            add or edit a gateway (prompts for its name)
  jackal use <name>         set the default gateway
  jackal --gateway <name>   launch against one gateway without changing the default
  jackal --list             show saved gateways
  jackal --remove <name>    delete a saved gateway
  jackal --version          jackal's version, and claude's
"""

import sys

# npm installs this file as a symlink on PATH. sys.path[0] is the *resolved*
# script directory, so the sibling package is importable through the symlink —
# verified on 3.9 and 3.13, and by an actual `npm i -g` install.
from jackal_lib.gateways import (
    CURRENT_FILE,
    list_gateways,
    migrate_old_config,
    print_list,
    read_current,
    resolve_gateway,
    write_current,
)
from jackal_lib.launch import launch, print_versions
from jackal_lib.setup import run_setup
from jackal_lib.terminal import open_tty


def _prompt_setup(args):
    tty_in, tty_out = open_tty()
    if tty_in is None:
        sys.exit("jackal: need a terminal to configure a gateway")
    try:
        name = run_setup(tty_out, tty_in)
    finally:
        tty_in.close()
        if tty_out is not tty_in:
            tty_out.close()
    launch(name, args)


def main():
    # A piped/redirected stdout on Windows defaults to the legacy ANSI code
    # page, which can't encode the checkmark/triangle glyphs below and would
    # crash instead of printing (e.g. `jackal --list > file`, or any command
    # under CI). Force UTF-8 so that always succeeds.
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass  # exotic stdio (e.g. replaced by a test harness) — best effort only

    args = sys.argv[1:]

    # Before migrate_old_config: asking for the version should never depend on
    # config state, and must still answer if the gateway store is broken.
    if args and args[0] in ("--version", "-V"):
        print_versions()
        return

    migrate_old_config()

    if args and args[0] in ("--setup", "--reconfigure"):
        _prompt_setup(args[1:])
        return

    if args and args[0] == "use":
        if len(args) < 2:
            sys.exit("jackal: use requires a gateway name, e.g. jackal use work")
        name = args[1]
        resolve_gateway(name)
        write_current(name)
        print(f'  ✓  default gateway is now "{name}"')
        return

    if args and args[0] == "--gateway":
        if len(args) < 2:
            sys.exit(
                "jackal: --gateway requires a gateway name, e.g. jackal --gateway work"
            )
        name = args[1]
        resolve_gateway(name)
        launch(name, args[2:])
        return

    if args and args[0] == "--list":
        print_list()
        return

    if args and args[0] == "--remove":
        if len(args) < 2:
            sys.exit(
                "jackal: --remove requires a gateway name, e.g. jackal --remove work"
            )
        name = args[1]
        path = resolve_gateway(name)
        was_current = read_current() == name
        path.unlink()
        if was_current:
            CURRENT_FILE.unlink(missing_ok=True)
        print(f'  ✓  removed gateway "{name}"')
        return

    names = list_gateways()
    if not names:
        _prompt_setup(args)
        return

    current = read_current()
    if current is None:
        if len(names) == 1:
            current = names[0]
        else:
            sys.exit(
                "jackal: multiple gateways saved, no default set — run `jackal use <name>`\n"
                "        saved gateways: " + ", ".join(names)
            )
    launch(current, args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
